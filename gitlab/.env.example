# GitLab Configuration
# Copy this file to .env and update with your values:
#   cp .env.example .env

# Your machine's IP address (for network access)
# Example: 192.168.1.100
GITLAB_HOST=

# Puma web server worker processes. Each worker is a full copy of the Rails
# app (~1GB RSS). 0 runs Puma in single mode - lowest memory, but no worker
# isolation and limited concurrency. Use 2+ on hosts with RAM to spare.
GITLAB_PUMA_WORKERS=0

# Sidekiq background job threads. Fewer threads means lower peak memory and
# slower background work (CI pipelines, emails, housekeeping). Default is 10.
GITLAB_SIDEKIQ_CONCURRENCY=5
